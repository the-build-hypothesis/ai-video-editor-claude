{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-video-editor-claude",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-video-editor-claude-db",
      "database_id": "c964a989-1cf7-4228-86a7-98268ac042ed",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ai-video-editor-claude-media" }
  ],
  "vars": {
    "APP_PUBLIC_URL": "https://ai-video-editor-v1-claude.thebuildhypothesis.com",
    "APP_PUBLIC_HOSTNAME": "ai-video-editor-v1-claude.thebuildhypothesis.com",
    "OPENAI_MODEL": "gpt-4o-mini",
    "OPENAI_TRANSCRIPTION_MODEL": "whisper-1",
    "D1_MAX_DB_MB": "450"
  },
  "routes": [
    { "pattern": "ai-video-editor-v1-claude.thebuildhypothesis.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] }
}
