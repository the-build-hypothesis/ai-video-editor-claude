{
  "name": "frameforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "deploy:d1": "FF_STORAGE=d1 npm run build && wrangler deploy",
    "e2e:noai": "SKIP_REAL_AI=1 playwright test"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "^1.65.2",
    "hono": "^4.13.17",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
